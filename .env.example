# Telemetry is off by default. The simulation remains fully local unless enabled.
TELEMETRY_ENABLED=false
TELEMETRY_DRY_RUN=true
TELEMETRY_SOURCE=ros1-noetic-simulation
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_TELEMETRY_TABLE=franka_telemetry

# Inject at runtime on a trusted edge host. Never commit the real value.
SUPABASE_TELEMETRY_KEY=replace-at-runtime
