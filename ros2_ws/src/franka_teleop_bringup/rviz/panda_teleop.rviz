Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Line Style:
        Line Width: 0.03
        Value: Lines
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Marker
      Name: TeleopMarkers
      Enabled: true
      Topic:
        Value: /teleop/markers
    - Class: rviz_default_plugins/Pose
      Name: CommandPose
      Enabled: true
      Topic:
        Value: /teleop/command_pose
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.008
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: panda_link0
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.35
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Yaw: 0.9
Window Geometry:
  Height: 800
  Width: 1200
